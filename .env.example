# Copiá este archivo como .env y completá los valores reales.
# Nunca subas el .env con valores reales a un repositorio público.

# API key gratuita de Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=

# Token de la API de WhatsApp Cloud API (Meta Developers > WhatsApp > API Setup)
WHATSAPP_TOKEN=

# ID del número de teléfono de WhatsApp Business (Meta Developers > WhatsApp > API Setup)
PHONE_NUMBER_ID=

# Token de verificación que inventás vos; debe coincidir con el que
# cargues al configurar el webhook en Meta Developers.
VERIFY_TOKEN=

# Tu número personal (admin): desde ahí le ordenás al bot con PAGADO.
ADMIN_PHONE_NUMBER=

# Links de descarga directa (Google Drive: uc?export=download&id=FILE_ID)
# de cada pack; el bot los envía solo cuando vos confirmás el pago.
DELIVERY_URL_59=
DELIVERY_URL_79=

# Puerto local (Vercel lo ignora)
PORT=3000
